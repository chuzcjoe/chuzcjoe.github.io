<div class="card"><div class="card-content"><h3 class="menu-label has-text-centered">Like this article? Support the author with</h3><div class="buttons is-centered">
<% for (const donate of config.donates) { const type=donate.type; %>
<a class="button donate" data-type="<%= type %>" <%- type === 'paypal' ? 'onclick="document.getElementById(\'paypal-donate-form\').submit()" role="button" tabindex="0"' : !donate.qrcode ? 'aria-disabled="true" title="QR code not configured"' : 'tabindex="0"' %>><span class="icon is-small"><i class="fab <%= type === 'wechat' ? 'fa-weixin' : 'fa-'+type %>"></i></span><span><%= type==='paypal' ? 'Paypal' : type==='wechat' ? 'Wechat' : 'Alipay' %></span><% if (donate.qrcode) { %><span class="qrcode"><img src="<%= donate.qrcode %>" alt="<%= type %>"></span><% } %></a>
<% if (type === 'paypal') { %><form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_blank" rel="noopener" id="paypal-donate-form"><input type="hidden" name="cmd" value="_donations"><input type="hidden" name="business" value="<%= donate.business %>"><input type="hidden" name="currency_code" value="<%= donate.currency_code %>"></form><% } %>
<% } %>
</div></div></div>
<% if (prev || next) { %><nav class="post-navigation mt-4 level is-mobile"><% if (prev) { %><div class="level-start"><a class="article-nav-prev level level-item link-muted" href="<%= prev.url %>"><i class="level-item fas fa-chevron-left"></i><span class="level-item"><%= prev.title %></span></a></div><% } %><% if (next) { %><div class="level-end"><a class="article-nav-next level level-item link-muted" href="<%= next.url %>"><span class="level-item"><%= next.title %></span><i class="level-item fas fa-chevron-right"></i></a></div><% } %></nav><% } %>
<% if (config.comment.type === 'disqus' && config.comment.shortname) { %><div class="card"><div class="card-content"><h3 class="title is-5">Comments</h3><div id="disqus_thread"><noscript>Please enable JavaScript to view the comments powered by Disqus.</noscript></div><script>
var disqus_config=function(){this.page.url=<%- JSON.stringify(new URL(post.url,config.url).href) %>;this.page.identifier=<%- JSON.stringify(post.url.slice(1)) %>;};
(function(){var s=document.createElement('script');s.src='https://'+<%- JSON.stringify(config.comment.shortname) %>+'.disqus.com/embed.js';s.setAttribute('data-timestamp',Date.now());(document.head||document.body).appendChild(s);})();
</script></div></div><% } %>
