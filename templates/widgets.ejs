<% for (const widget of widgets) { %>
<% if (widget.type === 'profile') { %>
<% const avatar = widget.position === 'left' ? config.widgets.find(w => w.type === 'profile' && w.position === 'left')?.avatar || widget.avatar : widget.avatar; %>
<div class="card widget" data-type="profile"><div class="card-content"><nav class="level"><div class="level-item has-text-centered flex-shrink-1"><div>
<figure class="image is-128x128 mx-auto mb-2"><img class="avatar<%= widget.avatar_rounded ? ' is-rounded' : '' %>" src="<%= avatar %>" alt="<%= widget.author || config.author %>"></figure>
<p class="title is-size-4 is-block" style="line-height:inherit;"><%= widget.author || config.author %></p><p class="is-size-6 is-block"><%= widget.author_title %></p><p class="is-size-6 is-flex justify-content-center"><i class="fas fa-map-marker-alt mr-1"></i><span><%= widget.location %></span></p>
</div></div></nav><nav class="level is-mobile"><% for (const [name, count, url] of [['Posts',site.posts.length,'/archives'],['Categories',site.categories.length,'/categories'],['Tags',site.tags.length,'/tags']]) { %><div class="level-item has-text-centered is-marginless"><div><p class="heading"><%= name %></p><a href="<%= url %>"><p class="title"><%= count %></p></a></div></div><% } %></nav>
<% if (widget.follow_link) { %><div class="level"><a class="level-item button is-primary is-rounded" href="<%= widget.follow_link %>" target="_blank" rel="noopener">Follow</a></div><% } %>
<div class="level is-mobile is-multiline"><% for (const [name,link] of Object.entries(widget.social_links || {})) { %><a class="level-item button is-transparent is-marginless" target="_blank" rel="noopener" title="<%= name %>" href="<%= link.url || link %>"><i class="<%= link.icon %>"></i></a><% } %></div>
</div></div>
<% } else if (widget.type === 'toc' && page.article?.toc && page.article.headings.length) { %>
<div class="card widget" id="toc" data-type="toc"><div class="card-content"><div class="menu"><h3 class="menu-label">Catalogue</h3><%- page.tocHtml(widget) %></div></div><% if (widget.collapsed) { %><style>#toc .menu-list>li>a.is-active+.menu-list{display:block}#toc .menu-list>li>a+.menu-list{display:none}</style><% } %><script src="/js/toc.js" defer></script></div>
<% } else if (widget.type === 'followit') { %>
<div class="card widget" data-type="subscribe-email"><div class="card-content"><div class="menu"><h3 class="menu-label">follow.it</h3><form action="<%= widget.action_url %>" method="post" target="_blank"><div class="field has-addons"><div class="control has-icons-left is-expanded"><input class="input" name="email" type="email" placeholder="Email" aria-label="Email" required><span class="icon is-small is-left"><i class="fas fa-envelope"></i></span></div><div class="control"><input class="button" type="submit" value="Subscribe"></div></div></form></div></div></div>
<% } else if (widget.type === 'adsense') { %>
<% const defaults = config.widgets.find(w => w.type === 'adsense') || {}; const client = String(widget.client_id || defaults.client_id || '').trim(); const slot = String(widget.slot_id || defaults.slot_id || '').trim(); const banner = widget.position === 'main'; %>
<div class="card widget<%= banner ? ' ad-banner' : '' %>" data-type="adsense"><div class="card-content"><div class="menu"><h3 class="menu-label">Advertisement</h3><ins class="adsbygoogle" style="<%= banner ? 'display:block;width:100%;height:50px' : 'display:block' %>" aria-label="Advertisement"<% if (client && slot) { %> data-ad-client="<%= client %>" data-ad-slot="<%= slot %>"<% if (!banner) { %> data-ad-format="auto" data-full-width-responsive="true"<% } %><% } %>></ins></div></div></div>
<% } else if (widget.type === 'recent_posts') { %>
<div class="card widget" data-type="recent-posts"><div class="card-content"><h3 class="menu-label">Recents</h3><% for (const post of site.posts.slice(0,widget.limit || 5)) { %><article class="media"><div class="media-content"><p class="date"><time datetime="<%= post.dateIso %>"><%= post.date %></time></p><p class="title"><a href="<%= post.url %>"><%= post.title %></a></p><p class="categories"><% for (const name of post.categories) { %><a href="/categories/<%= routePart(name) %>/"><%= name %></a><% } %></p></div></article><% } %></div></div>
<% } else if (widget.type === 'archives') { %>
<div class="card widget" data-type="archives"><div class="card-content"><div class="menu"><h3 class="menu-label">Archives</h3><ul class="menu-list"><% for (const year of site.years) { %><li><a class="level is-mobile" href="/archives/<%= year.year %>/"><span class="level-start"><span class="level-item"><%= year.year %></span></span><span class="level-end"><span class="level-item tag"><%= year.posts.length %></span></span></a></li><% } %></ul></div></div></div>
<% } %>
<% } %>
